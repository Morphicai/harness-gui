{
  "name": "harness-gui",
  "version": "0.4.0",
  "description": "A bridge between your program and a human — notify, show, confirm, select, form. Terminal, browser, or a native window.",
  "license": "MIT",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "harness-gui-daemon": "dist/daemon/bin.js"
  },
