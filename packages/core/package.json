    "prompt",
    "confirm",
    "approval",
    "agent",
    "mcp"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Morphicai/harness-gui.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/Morphicai/harness-gui#readme",
  "engines": {
    "node": ">=18"
  },
  "optionalDependencies": {
    "@harness-gui/shell-darwin-arm64": "0.4.0",
    "@harness-gui/shell-darwin-x64": "0.4.0",
    "@harness-gui/shell-win32-x64": "0.4.0"
  }
}
